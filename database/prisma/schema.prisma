model AbandonedCartRecovery {
  id                         String    @id @default(uuid())
  checkoutSessionId          String    @unique @map("checkout_session_id")
  clienteNome                String    @map("cliente_nome")
  clienteEmail               String    @map("cliente_email")
  clienteTelefone            String    @map("cliente_telefone")
  eventoId                   String    @map("evento_id")
  nomeEvento                 String    @map("nome_evento")
  setorLote                  String    @map("setor_lote")
  quantidadeIngressos        Int       @map("quantidade_ingressos")
  valorTotal                 Decimal   @db.Decimal(10, 2) @map("valor_total")
  estagioAbandono            String    @map("estagio_abandono") // SELECAO_ASSENTO, IDENTIFICACAO, PAGAMENTO_PENDENTE, RECUSADO_ANTIFRAUDE
  statusRecuperacao          String    @default("ABANDONADO_RECENTE") @map("status_recuperacao") // ABANDONADO_RECENTE, GATILHO_WHATSAPP_ENVIADO, GATILHO_SMS_ENVIADO, RECUPERADO, EXPIRADO
  dataAbandono               DateTime  @default(now()) @map("data_abandono")
  dataRecuperacao            DateTime? @map("data_recuperacao")
  cupomIncentivo             String?   @map("cupom_incentivo")
  canalRecuperacao           String?   @map("canal_recuperacao") // WHATSAPP, SMS, EMAIL, PUSH
  urlRecuperacaoCheckout     String    @map("url_recuperacao_checkout")

  @@index([statusRecuperacao])
  @@map("abandoned_cart_recoveries")
}

model RfmCustomerSegment {
  id                         String    @id @default(uuid())
  clienteCpf                 String    @unique @map("cliente_cpf")
  clienteNome                String    @map("cliente_nome")
  clienteEmail               String    @map("cliente_email")
  recenciaDias               Int       @map("recencia_dias") // Dias desde a última compra
  frequenciaEventos          Int       @map("frequencia_eventos") // Total de eventos comprados
  valorMonetarioTotal        Decimal   @db.Decimal(15, 2) @map("valor_monetario_total") // LTV
  clusterRfm                 String    @map("cluster_rfm") // CHAMPIONS, LOYAL, AT_RISK, ABOUT_TO_SLEEP, HIBERNATING
  scoreRfmPontuacao          Decimal   @db.Decimal(4, 2) @map("score_rfm_pontuacao") // ex: 9.80 / 10
  audienciaMetaCustomSync    Boolean   @default(true) @map("audiencia_meta_custom_sync")
  audienciaGoogleMatchSync   Boolean   @default(true) @map("audiencia_google_match_sync")
  ultimaAtualizacao          DateTime  @default(now()) @map("ultima_atualizacao")

  @@index([clusterRfm])
  @@map("rfm_customer_segments")
}

model RemarketingTriggerAutomation {
  id                         String    @id @default(uuid())
  nomeRegra                  String    @map("nome_regra")
  gatilhoEvento              String    @map("gatilho_evento") // CARRINHO_ABANDONADO_15M, RECUSA_CARTAO_MIGRA_PIX, VIRADA_LOTE_IMINENTE, REENGAJAMENTO_POS_SHOW
  tempoEsperaMinutos         Int       @default(15) @map("tempo_espera_minutos")
  canalEnvio                 String    @map("canal_envio") // WHATSAPP_API, SMS_GATEWAY, EMAIL_SMTP
  templateMensagem           String    @map("template_mensagem")
  ativo                      Boolean   @default(true) @map("ativo")
  totalDisparos              Int       @default(0) @map("total_disparos")
  totalConvertidos           Int       @default(0) @map("total_convertidos")
  taxaConversaoPercent       Decimal   @default(0.00) @db.Decimal(5, 2) @map("taxa_conversao_percent")
  createdAt                  DateTime  @default(now()) @map("created_at")

  @@map("remarketing_trigger_automations")
}
















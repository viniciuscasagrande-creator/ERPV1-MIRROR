// FASE 26: Governança de Sustentabilidade (ESG), Inventário de Pegada de Carbono
// (GHG Protocol Escopos 1, 2 e 3) & Borderô Verde com Créditos de Carbono
// Normas: GHG Protocol Corporate Standard, CVM Res. 193/23 & IFRS S1 / S2
// ============================================================================

model EventCarbonFootprint {
  id                    String   @id @default(uuid())
  eventoId              String   @map("evento_id")
  codigoInventario      String   @unique @map("codigo_inventario") // Ex: "GHG-EVT-2026-001"
  nomeEvento            String   @map("nome_evento")
  periodoReferencia     String   @map("periodo_referencia") // Ex: "2026-03"
  publicoPresenteTotal  Int      @default(0) @map("publico_presente_total")
  totalIngressosEmitidos Int     @default(0) @map("total_ingressos_emitidos")
  escopo1KgCo2e         Decimal  @default(0.00) @db.Decimal(15, 2) @map("escopo_1_kg_co2e") // Geradores diesel, frotas próprias
  escopo2KgCo2e         Decimal  @default(0.00) @db.Decimal(15, 2) @map("escopo_2_kg_co2e") // Consumo elétrico arena (rede)
  escopo3KgCo2e         Decimal  @default(0.00) @db.Decimal(15, 2) @map("escopo_3_kg_co2e") // Deslocamento público (CEP) e resíduos
  totalKgCo2e           Decimal  @default(0.00) @db.Decimal(15, 2) @map("total_kg_co2e")
  totalToneladasCo2e    Decimal  @default(0.000) @db.Decimal(15, 3) @map("total_toneladas_co2e")
  fatorMedioPorIngressoKg Decimal @default(0.00) @db.Decimal(10, 3) @map("fator_medio_por_ingresso_kg")
  statusInventario      String   @default("EM_APURACAO") @map("status_inventario") // EM_APURACAO, AUDITADO_TERCEIROS, NEUTRALIZADO
  auditadoPor           String?  @map("auditado_por")
  criadoEm              DateTime @default(now()) @map("criado_em")
  atualizadoEm          DateTime @updatedAt @map("atualizado_em")

  greenBorderoEntries   GreenBorderoEntry[]

  @@index([eventoId])
  @@index([statusInventario])
  @@map("event_carbon_footprints")
}

model CarbonCreditOffset {
  id                    String   @id @default(uuid())
  codigoCertificado     String   @unique @map("codigo_certificado") // Ex: "VCS-2026-89412"
  padraoCertificacao    String   @map("padrao_certificacao") // VERRA_VCS, GOLD_STANDARD, B3_CBIOMOB, REDD_PLUS
  projetoNome           String   @map("projeto_nome") // Ex: "Reflorestamento Bacia do Iguaçu REDD+"
  bioma                 String   @map("bioma") // MATA_ATLANTICA, AMAZONIA, CERRADO
  numeroSerieSerial     String   @unique @map("numero_serie_serial")
  toneladasDisponiveis  Decimal  @db.Decimal(15, 3) @map("toneladas_disponiveis")
  toneladasCompensadas  Decimal  @default(0.000) @db.Decimal(15, 3) @map("toneladas_compensadas")
  precoPorToneladaBrl   Decimal  @db.Decimal(10, 2) @map("preco_por_tonelada_brl")
  custoTotalBrl         Decimal  @db.Decimal(15, 2) @map("custo_total_brl")
  status                String   @default("RESERVADO") // RESERVADO, LIQUIDADO_BORDERO, APOSENTADO_REGISTRO
  urlRegistroPublico    String?  @map("url_registro_publico")
  dataAposentadoria     DateTime? @map("data_aposentadoria")
  criadoEm              DateTime @default(now()) @map("criado_em")

  greenBorderoEntries   GreenBorderoEntry[]

  @@index([padraoCertificacao])
  @@index([status])
  @@map("carbon_credit_offsets")
}

model GreenBorderoEntry {
  id                    String   @id @default(uuid())
  codigoRetencaoVerde   String   @unique @map("codigo_retencao_verde") // Ex: "GBR-2026-0001"
  borderoFechamentoId   String   @map("bordero_fechamento_id")
  eventoId              String   @map("evento_id")
  produtorId            String   @map("produtor_id")
  taxaVerdePorIngressoBrl Decimal @db.Decimal(10, 2) @map("taxa_verde_por_ingresso_brl") // Ex: R$ 1,50 / ingresso neutro
  totalIngressosCompensados Int  @map("total_ingressos_compensados")
  totalRetidoSustentabilidadeBrl Decimal @db.Decimal(15, 2) @map("total_retido_sustentabilidade_brl")
  toneladasCompensadas  Decimal  @db.Decimal(15, 3) @map("toneladas_compensadas")
  statusCompensacao     String   @default("RETIDO") @map("status_compensacao") // RETIDO, APLICADO, CERTIFICADO_EMITIDO
  contaContabilDebito   String   @map("conta_contabil_debito")
  contaContabilCredito  String   @map("conta_contabil_credito")
  dataLancamento        DateTime @default(now()) @map("data_lancamento")

  footprintId           String?  @map("footprint_id")

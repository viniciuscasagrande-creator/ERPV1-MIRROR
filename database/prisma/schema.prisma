// ------------------------------------------------------------------------------
// FASE 9: GOVERNANÇA CONTÁBIL, TRAVAS DE PERÍODO & FECHAMENTO MENSAL
// ------------------------------------------------------------------------------

model AccountingPeriod {
  id                      String                @id @default(uuid())
  competencia             String                @unique // Ex: "2026-08", "2026-09"
  ano                     Int
  mes                     Int
  dataInicio              DateTime              @map("data_inicio")
  dataFim                 DateTime              @map("data_fim")
  status                  StatusPeriodoContabil @default(ABERTO)
  
  // Checklist de Fechamento Contábil (5 Pilares)
  conciliacaoBancariaOk   Boolean               @default(false) @map("conciliacao_bancaria_ok")
  conciliacaoMdrOk        Boolean               @default(false) @map("conciliacao_mdr_ok")
  partidasDobradasOk      Boolean               @default(false) @map("partidas_dobradas_ok")
  apuracaoFiscalOk        Boolean               @default(false) @map("apuracao_fiscal_ok")
  fechamentoEventosOk     Boolean               @default(false) @map("fechamento_eventos_ok")

  // Carimbos e Auditoria
  fechadoPorId            String?               @map("fechado_por_id")
  fechadoPorNome          String?               @map("fechado_por_nome")
  fechadoEm               DateTime?             @map("fechado_em")
  justificativaFechamento String?               @map("justificativa_fechamento")
  
  reabertoPorId           String?               @map("reaberto_por_id")
  reabertoPorNome         String?               @map("reaberto_por_nome")
  reabertoEm              DateTime?             @map("reaberto_em")
  motivoReabertura        String?               @map("motivo_reabertura")

  // Resumo Financeiro Consolidado da Competência
  totalReceitas           Decimal               @default(0.00) @db.Decimal(15, 2) @map("total_receitas")
  totalDespesas           Decimal               @default(0.00) @db.Decimal(15, 2) @map("total_despesas")
  resultadoPeriodo        Decimal               @default(0.00) @db.Decimal(15, 2) @map("resultado_periodo")

  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt      @map("updated_at")

  @@index([status])
  @@index([ano, mes])
  @@map("accounting_periods")
}

// ------------------------------------------------------------------------------
// FASE 11: GED (GESTÃO ELETRÔNICA DE DOCUMENTOS) & LOTES BANCÁRIOS CNAB 240
// ------------------------------------------------------------------------------

model DocumentItem {
  id              String    @id @default(uuid())
  nomeArquivo     String    @map("nome_arquivo")
  descricao       String
  categoria       String    // CONTRATO_PRODUTOR, ALVARA_EVENTO, COMPROVANTE_PAGAMENTO, DOCUMENTO_FISCAL, OUTRO
  tamanhoBytes    Int       @default(0) @map("tamanho_bytes")
  formato         String    @default("PDF") // PDF, PNG, JPG, XML, ZIP
  urlArquivo      String?   @map("url_arquivo")
  hashSha256      String    @map("hash_sha256")
  referenciaTipo  String?   @map("referencia_tipo") // EVENTO, PRODUTOR, REPASSE, GERAL
  referenciaId    String?   @map("referencia_id")
  criadoPor       String?   @map("criado_por")
  criadoEm        DateTime  @default(now()) @map("criado_em")

  @@index([categoria])
  @@index([referenciaTipo, referenciaId])
  @@map("document_items")
}

model CnabBatch {
  id              String    @id @default(uuid())
  codigoLote      String    @unique @map("codigo_lote") // Ex: "CNAB-2026-000041"
  bancoCodigo     String    @map("banco_codigo") // 341 Itaú, 237 Bradesco
  tipoOperacao    String    @map("tipo_operacao") // REMESSA_PAGAMENTO, RETORNO_LIQUIDACAO
  totalRegistros  Int       @default(0) @map("total_registros")
  valorTotal      Decimal   @default(0.00) @db.Decimal(15, 2) @map("valor_total")
  status          String    @default("GERADO") // GERADO, ENVIADO_BANCO, PROCESSADO_RETORNO, REJEITADO
  conteudoArquivo String    @db.Text @map("conteudo_arquivo")
  geradoPor       String?   @map("gerado_por")
  processadoEm    DateTime? @map("processado_em")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  @@index([bancoCodigo])
  @@index([status])
  @@map("cnab_batches")
}

// ------------------------------------------------------------------------------
// FASE 12: NOTIFICAÇÕES EM TEMPO REAL & WEBHOOKS DE EVENTOS FINANCEIROS
// ------------------------------------------------------------------------------

model AppNotification {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  producerId   String?   @map("producer_id")
  tipo         String    // FECHAMENTO_EVENTO, REPASSE_LIBERADO, DIVERGENCIA_MDR, TRAVA_CONTABIL, LOTE_CNAB, SISTEMA
  titulo       String
  mensagem     String
  severidade   String    @default("INFO") // INFO, SUCCESS, WARNING, CRITICAL
  lida         Boolean   @default(false)
  linkAcao     String?   @map("link_acao")
  metadata     Json?
  criadoEm     DateTime  @default(now()) @map("criado_em")

  @@index([userId, lida])
  @@index([producerId])
  @@index([tipo])
  @@map("app_notifications")
}

model WebhookSubscription {
  id            String    @id @default(uuid())
  nome          String
  url           String
  secret        String    // HMAC-SHA256 signature key
  ativo         Boolean   @default(true)
  eventos       String[]  // ['evento.fechado', 'repasse.liquidado', 'mdr.divergencia', 'competencia.fechada']
  ultimoDisparo DateTime? @map("ultimo_disparo")
  ultimoStatus  Int?      @map("ultimo_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  logs          WebhookDeliveryLog[]

  @@index([ativo])
  @@map("webhook_subscriptions")
}

model WebhookDeliveryLog {
  id             String              @id @default(uuid())
  subscriptionId String              @map("subscription_id")
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  evento         String
  payload        Json
  statusCode     Int?                @map("status_code")
  sucesso        Boolean             @default(false)
  resposta       String?             @db.Text
  tentativas     Int                 @default(1)
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([evento])
  @@index([sucesso])
  @@map("webhook_delivery_logs")
}

// ------------------------------------------------------------------------------
// FASE 13: EXPORTADORES AVANÇADOS & INTEGRAÇÕES CONTÁBEIS EXTERNAS
// (Domínio Sistemas, Fortes Contábil, Questor, Planilhas Estruturadas)
// ------------------------------------------------------------------------------

model AccountingExportBatch {

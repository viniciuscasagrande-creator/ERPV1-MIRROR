  dataHoraCotacao       DateTime @default(now()) @map("data_hora_cotacao")
  fonteCotacao          String   @default("BACEN_SISBACEN_PTAX") @map("fonte_cotacao")
  ativa                 Boolean  @default(true)

  @@index([moedaOrigem, ativa])
  @@map("currency_exchange_rates")
}

model InternationalTicketSale {

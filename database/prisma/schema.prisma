  carbonCreditOffsetId  String?  @map("carbon_credit_offset_id")
  carbonCreditOffset    CarbonCreditOffset? @relation(fields: [carbonCreditOffsetId], references: [id])

  @@index([borderoFechamentoId])
  @@index([eventoId])
  @@index([produtorId])

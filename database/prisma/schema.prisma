  ingressosVendidos          Int       @default(0) @map("ingressos_vendidos")
  receitaGerada              Decimal   @default(0.00) @db.Decimal(15, 2) @map("receita_gerada")
  roasCalculado              Decimal   @default(0.00) @db.Decimal(8, 2) @map("roas_calculado") // ex: 8.4x
  cpaMedio                   Decimal   @default(0.00) @db.Decimal(10, 2) @map("cpa_medio")
  utmSource                  String    @map("utm_source")
  utmMedium                  String    @map("utm_medium")
  utmCampaign                String    @map("utm_campaign")
  dataInicio                 DateTime  @map("data_inicio")
  dataFim                    DateTime? @map("data_fim")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("marketing_campaigns")
}

model MarketingCoupon {
  id                         String    @id @default(uuid())
  codigoCupom                String    @unique @map("codigo_cupom") // Ex: "VIPDISK20"
  descricao                  String    @map("descricao")
  eventId                    String?   @map("event_id")
  nomeEvento                 String?   @map("nome_evento")
  tipoDesconto               String    @map("tipo_desconto") // PERCENTUAL, VALOR_FIXO, ISENCAO_TAXA
  valorDesconto              Decimal   @db.Decimal(10, 2) @map("valor_desconto")
  limiteUsosGlobal           Int       @default(1000) @map("limite_usos_global")
  usosAtuais                 Int       @default(0) @map("usos_atuais")
  limitePorCpf               Int       @default(1) @map("limite_por_cpf")
  valorMinimoPedido          Decimal   @default(0.00) @db.Decimal(10, 2) @map("valor_minimo_pedido")
  receitaTotalGerada         Decimal   @default(0.00) @db.Decimal(15, 2) @map("receita_total_gerada")
  descontoTotalConcedido     Decimal   @default(0.00) @db.Decimal(15, 2) @map("desconto_total_concedido")
  status                     String    @default("ATIVO") @map("status") // ATIVO, ESGOTADO, EXPIRADO, PAUSADO
  validoAte                  DateTime  @map("valido_ate")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("marketing_coupons")
}

model MarketingPromoterAffiliate {
  id                         String    @id @default(uuid())
  codigoPromoter             String    @unique @map("codigo_promoter") // Ex: "PRM-LUCAS-VIP"
  nomePromoter               String    @map("nome_promoter")
  email                      String    @map("email")
  telefoneWhatsapp           String    @map("telefone_whatsapp")
  chavePix                   String    @map("chave_pix")
  tipoComissao               String    @default("PERCENTUAL") @map("tipo_comissao") // PERCENTUAL, FIXO_POR_INGRESSO
  taxaComissao               Decimal   @db.Decimal(5, 2) @map("taxa_comissao") // ex: 5.00%
  slugLink                   String    @unique @map("slug_link") // ex: "lucasvip"
  ingressosVendidos          Int       @default(0) @map("ingressos_vendidos")
  volumeVendasBRL            Decimal   @default(0.00) @db.Decimal(15, 2) @map("volume_vendas_brl")
  comissaoTotalAcumulada     Decimal   @default(0.00) @db.Decimal(15, 2) @map("comissao_total_acumulada")
  comissaoPaga               Decimal   @default(0.00) @db.Decimal(15, 2) @map("comissao_paga")
  comissaoPendente           Decimal   @default(0.00) @db.Decimal(15, 2) @map("comissao_pendente")
  status                     String    @default("ATIVO") @map("status") // ATIVO, SUSPENSO
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  @@map("marketing_promoter_affiliates")
}

model MarketingPixelCapiLog {
  id                         String    @id @default(uuid())
  eventIdTrace               String    @unique @map("event_id_trace") // UUID do checkout
  plataformaDestino          String    @map("plataforma_destino") // META_CAPI, GOOGLE_ENHANCED, TIKTOK_EVENTS
  tipoEvento                 String    @map("tipo_evento") // Purchase, InitiateCheckout, AddToCart, ViewContent
  valorTransacao             Decimal   @db.Decimal(10, 2) @map("valor_transacao")
  moeda                      String    @default("BRL") @map("moeda")
  statusEnvio                String    @default("ENVIADO_SUCESSO") @map("status_envio")
  deduplicacaoScore          Decimal   @default(9.20) @db.Decimal(4, 2) @map("deduplicacao_score")
  respostaPayloadHash        String    @map("resposta_payload_hash")
  timestampEvento            DateTime  @default(now()) @map("timestamp_evento")

  @@index([plataformaDestino])
  @@map("marketing_pixel_capi_logs")
}


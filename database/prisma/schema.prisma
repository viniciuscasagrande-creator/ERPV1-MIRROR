  sistemaDestino  String   @map("sistema_destino") // DOMINIO_SISTEMAS, FORTES_CONTABIL, QUESTOR, CSV_EXCEL
  tipoDado        String   @map("tipo_dado") // LANCAMENTOS_DIARIO, PLANO_CONTAS, BALANCETE, REPASSES, RETENCOES
  periodoInicio   DateTime @map("periodo_inicio")
  periodoFim      DateTime @map("periodo_fim")
  totalRegistros  Int      @default(0) @map("total_registros")

  chavePixRecebedor     String                    @map("chave_pix_recebedor")
  qrCodePayload         String                    @map("qr_code_payload") // EMVco Copia e Cola
  qrCodeImageUrl        String?                   @map("qr_code_image_url")
  status                String                    @default("ATIVA") // ATIVA, CONCLUIDA, EXPIRADA
  dataCriacao           DateTime                  @default(now()) @map("data_criacao")
  dataExpiracao         DateTime                  @map("data_expiracao")
  liquidadoEm           DateTime?                 @map("liquidado_em")

  reconciliations       RealtimeReconciliationLog[]

  @@index([eventId])
  @@index([producerId])
  @@index([status])
  @@index([endToEndId])
  @@map("pix_cobrancas_dynamic")
}

model OpenFinancePaymentOrder {
  id                    String                    @id @default(uuid())
  codigoOrdem           String                    @unique @map("codigo_ordem") // Ex: "ITP-2026-0042"
  consentId             String                    @map("consent_id")
  consent               OpenFinanceConsent        @relation(fields: [consentId], references: [id], onDelete: Restrict)
  eventId               String?                   @map("event_id")
  tipoFinalidade        String                    @map("tipo_finalidade") // REPASSE_PRODUTOR, DIVIDENDO_SCP, ANTECIPACAO, FORNECEDOR

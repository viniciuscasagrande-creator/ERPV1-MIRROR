model RwaAccountingRegister {
  id                    String   @id @default(uuid())
  codigoLancamento      String   @unique @map("codigo_lancamento") // Ex: "OCPC10-2026-001"
  tokenPoolId           String   @map("token_pool_id")
  tipoLancamento        String   @map("tipo_lancamento") // CAPTACAO_INICIAL, LIBERACAO_ESCROW, LIQUIDACAO_INVESTIDOR, ROYALTY_SECUNDARIO
  valorBrl              Decimal  @db.Decimal(15, 2) @map("valor_brl")
  contaDebito           String   @map("conta_debito")

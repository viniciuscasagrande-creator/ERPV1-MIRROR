// ------------------------------------------------------------------------------
// FASE 14: DISASTER RECOVERY, BACKUP AUTOMATIZADO & RETENÇÃO CONTÁBIL (5 ANOS)
// Lei Federal 10.406/2002 Art. 1.194 & Lei Complementar 123/2006 Art. 26
// ------------------------------------------------------------------------------

model BackupSnapshot {
  id              String   @id @default(uuid())
  codigoSnapshot  String   @unique @map("codigo_snapshot") // Ex: "BKP-SNAP-2026-08-31-001"
  tipo            String   // COMPLETO, INCREMENTAL, CONTABIL_LEGAL, FISCAL_SPED
  tamanhoBytes    BigInt   @default(0) @map("tamanho_bytes")
  status          String   @default("CONCLUIDO") // EM_EXECUCAO, CONCLUIDO, FALHA, RESTAURADO
  checksumSha256  String   @map("checksum_sha256")
  armazenamento   String   @default("S3_COMPLIANT_COLD") // S3_COMPLIANT_COLD, LOCAL_ENCRYPTED, GLACIER
  retencaoAte     DateTime @map("retencao_ate") // 5 anos no futuro
  totalTabelas    Int      @default(0) @map("total_tabelas")
  totalLinhas     Int      @default(0) @map("total_linhas")
  criadoPor       String?  @map("criado_por")
  createdAt       DateTime @default(now()) @map("created_at")

  restoreLogs     RestoreDrAuditLog[]

  @@index([tipo])
  @@index([status])
  @@index([retencaoAte])
  @@map("backup_snapshots")
}

model RestoreDrAuditLog {
  id              String          @id @default(uuid())
  snapshotId      String          @map("snapshot_id")
  snapshot        BackupSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  solicitadoPor   String          @map("solicitado_por")
  motivo          String
  resultado       String          // SUCESSO, REJEITADO, EM_EXECUCAO
  ambienteDestino String          // SANDBOX_AUDITORIA, HOMOLOGACAO, PRODUCAO
  duracaoSegundos Int             @default(0) @map("duracao_segundos")
  ipOrigem        String?         @map("ip_origem")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([snapshotId])
  @@index([resultado])
  @@map("restore_dr_audit_logs")
}

// ------------------------------------------------------------------------------
// FASE 15: GOVERNANÇA FINANCEIRA, ALÇADAS MULTINÍVEL & SEGREGAÇÃO DE FUNÇÕES (SoD)
// Compliance Corporativo, Cadeia de Custódia e Controle de Risco Patrimonial
// ------------------------------------------------------------------------------

model ApprovalAuthorityRule {
  id                  String   @id @default(uuid())
  tipoOperacao        String   @map("tipo_operacao") // REPASSE_PRODUTOR, ANTECIPACAO_RECEBIVEIS, LOTE_PAGAMENTO_CNAB, AJUSTE_LEDGER, DESVIO_TAXA_MDR
  faixaNome           String   @map("faixa_nome") // FAIXA_A, FAIXA_B, FAIXA_C
  descricao           String
  valorMinimo         Decimal  @default(0.00) @db.Decimal(15, 2) @map("valor_minimo")
  valorMaximo         Decimal? @db.Decimal(15, 2) @map("valor_maximo") // null = sem teto
  perfilMinimo        String   @map("perfil_minimo") // ANALISTA_SENIOR, GERENTE_FINANCEIRO, DIRETOR_CFO
  requerDuplaAprovacao Boolean @default(false) @map("requer_dupla_aprovacao")
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([tipoOperacao])
  @@index([faixaNome])
  @@map("approval_authority_rules")
}

model ApprovalRequest {
  id                      String    @id @default(uuid())
  codigo                  String    @unique // Ex: "APV-2026-000412"
  tipoOperacao            String    @map("tipo_operacao") // REPASSE_PRODUTOR, ANTECIPACAO, LOTE_CNAB, AJUSTE_LEDGER, DADOS_BANCARIOS
  referenciaId            String?   @map("referencia_id")
  referenciaDescricao     String?   @map("referencia_descricao")
  valor                   Decimal   @default(0.00) @db.Decimal(15, 2)
  solicitadoPorId         String    @map("solicitado_por_id")
  solicitadoPorNome       String    @map("solicitado_por_nome")
  status                  String    @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO, CANCELADO
  alcadaExigida           String    @map("alcada_exigida") // FAIXA_A, FAIXA_B, FAIXA_C
  aprovador1Id            String?   @map("aprovador_1_id")
  aprovador1Nome          String?   @map("aprovador_1_nome")
  aprovado1Em             DateTime? @map("aprovado_1_em")
  aprovador2Id            String?   @map("aprovador_2_id")
  aprovador2Nome          String?   @map("aprovador_2_nome")
  aprovado2Em             DateTime? @map("aprovado_2_em")
  motivoRejeicao          String?   @map("motivo_rejeicao")
  justificativaSolicitacao String   @db.Text @map("justificativa_solicitacao")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([tipoOperacao])
  @@index([status])
  @@index([solicitadoPorId])
  @@map("approval_requests")
}

model SensitiveOperationAudit {
  id                 String    @id @default(uuid())
  codigoOperacao     String    @unique @map("codigo_operacao") // Ex: "SENS-2026-08-001"
  tipoOperacao       String    @map("tipo_operacao") // ALTERACAO_DADOS_BANCARIOS, AJUSTE_LEDGER, REABERTURA_BORDERO, DESVIO_MDR, QUARENTENA_PIX
  titulo             String
  executadoPor       String    @map("executado_por")
  perfilExecutante   String    @map("perfil_executante")
  justificativa      String    @db.Text
  statusQuarentena   String    @default("LIBERADO") @map("status_quarentena") // EM_QUARENTENA_48H, APROVADO_DIRETORIA, REJEITADO, LIBERADO
  quarentenaExpiraEm DateTime? @map("quarentena_expira_em")
  detalhesPayload    String?   @db.Text @map("detalhes_payload")
  ipOrigem           String?   @map("ip_origem")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([tipoOperacao])
  @@index([statusQuarentena])
  @@map("sensitive_operation_audits")
}

// ------------------------------------------------------------------------------
// FASE 16: ASSINATURAS DIGITAIS JURÍDICAS, BORDERÔS ELETRÔNICOS & CONTA AZUL
// Medida Provisória 2.200-2/2001 & Lei Federal 14.063/2020 (Autentique / Clicksign)
// ------------------------------------------------------------------------------

model DigitalSignatureDocument {
  id                   String   @id @default(uuid())
  codigoDocumento      String   @unique @map("codigo_documento") // Ex: "DOC-SIG-2026-000312"
  titulo               String
  tipoDocumento        String   @map("tipo_documento") // BORDERO_FECHAMENTO, TERMO_REPASSE, CONTRATO_ANTECIPACAO, CONTRATO_PRESTACAO_SERVICOS
  referenciaId         String?  @map("referencia_id")
  producerId           String?  @map("producer_id")
  producerNome         String?  @map("producer_nome")
  provedor             String   @default("AUTENTIQUE") // AUTENTIQUE, CLICKSIGN, DOCUSIGN, INTERNAL_ICP_BRASIL
  externalDocumentId   String?  @map("external_document_id")
  status               String   @default("AGUARDANDO_PRODUTOR") // RASCUNHO, ENVIADO, AGUARDANDO_PRODUTOR, AGUARDANDO_DISKINGRESSOS, CONCLUIDO_ASSINADO, REJEITADO, CANCELADO
  urlDocumentoOriginal String?  @map("url_documento_original")
  urlDocumentoAssinado String?  @map("url_documento_assinado")
  checksumSha256       String   @map("checksum_sha256")
  valorTotal           Decimal  @default(0.00) @db.Decimal(15, 2) @map("valor_total")
  criadoPor            String   @map("criado_por")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  signatarios          DigitalSignatureSigner[]
  syncIntegracoes      ErpSyncQueue[]

  @@index([tipoDocumento])
  @@index([status])
  @@index([producerId])
  @@map("digital_signature_documents")
}

model DigitalSignatureSigner {
  id                 String                   @id @default(uuid())
  documentId         String                   @map("document_id")
  document           DigitalSignatureDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  nome               String
  email              String
  cpfCnpj            String?                  @map("cpf_cnpj")
  tipoSignatario     String                   @map("tipo_signatario") // PRODUTOR_1_ORDEM, DISKINGRESSOS_2_ORDEM, TESTEMUNHA
  ordemAssinatura    Int                      @map("ordem_assinatura") // 1: Produtor primeiro, 2: Disk por último
  status             String                   @default("PENDENTE") // PENDENTE, ASSINADO, REJEITADO
  assinadoEm         DateTime?                @map("assinado_em")
  ipAssinatura       String?                  @map("ip_assinatura")
  metodoAutenticacao String?                  @map("metodo_autenticacao") // EMAIL_OTP, SMS_TOKEN, CERTIFICADO_A1_ICP
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@index([documentId])
  @@index([email])
  @@index([status])
  @@map("digital_signature_signers")
}

model ErpSyncQueue {
  id                 String                    @id @default(uuid())
  documentId         String?                   @map("document_id")
  document           DigitalSignatureDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sistemaDestino     String                    @default("CONTA_AZUL") @map("sistema_destino") // CONTA_AZUL, OMIE, SENIOR, SANKHYA
  entidade           String                    // CONTAS_A_PAGAR, CONTAS_A_RECEBER, CLIENTE_PRODUTOR
  referenciaExterna  String?                   @map("referencia_externa")
  status             String                    @default("PENDENTE") // PENDENTE, PROCESSANDO, SINCRONIZADO, DIVERGENTE, ERRO, AGUARDANDO_REPROCESSAMENTO
  tentativas         Int                       @default(0)
  ultimoErro         String?                   @map("ultimo_erro")
  payloadEnvio       String?                   @db.Text @map("payload_envio")
  respostaPayload    String?                   @db.Text @map("resposta_payload")
  sincronizadoEm     DateTime?                 @map("sincronizado_em")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([sistemaDestino])
  @@index([status])
  @@map("erp_sync_queues")
}

// ------------------------------------------------------------------------------
// FASE 17: ANTECIPAÇÕES FINANCEIRAS, CESSÃO DE RECEBÍVEIS & TRAVAS BANCÁRIAS
// Resolução BCB nº 4.734/2019 e Circular BCB nº 3.952/2019 (CERC, CIP, B3, TAG)
// ------------------------------------------------------------------------------

model AntecipacaoRecebivel {
  id                   String                  @id @default(uuid())
  codigoContrato       String                  @unique @map("codigo_contrato") // Ex: "ANT-2026-000101"
  producerId           String                  @map("producer_id")
  producerNome         String                  @map("producer_nome")
  eventId              String                  @map("event_id")
  eventNome            String                  @map("event_nome")
  valorSolicitado      Decimal                 @db.Decimal(15, 2) @map("valor_solicitado")
  taxaMensal           Decimal                 @db.Decimal(5, 2) @map("taxa_mensal") // Ex: 2.50%
  prazoDias            Int                     @default(30) @map("prazo_dias")
  custoFinanceiro      Decimal                 @db.Decimal(15, 2) @map("custo_financeiro")
  taxaAdministrativa   Decimal                 @default(0.00) @db.Decimal(15, 2) @map("taxa_administrativa")
  valorLiquidoLiberado Decimal                 @db.Decimal(15, 2) @map("valor_liquido_liberado")
  saldoDevedor         Decimal                 @db.Decimal(15, 2) @map("saldo_devedor")
  valorAmortizado      Decimal                 @default(0.00) @db.Decimal(15, 2) @map("valor_amortizado")
  fundoReservaRetido   Decimal                 @default(0.00) @db.Decimal(15, 2) @map("fundo_reserva_retido") // Escrow de segurança (ex: 20%)
  status               String                  @default("SOLICITADA") // RASCUNHO, SOLICITADA, EM_ANALISE, APROVADA, REJEITADA, LIBERADA, EM_AMORTIZACAO, QUITADA, INADIMPLENTE
  dataSolicitacao      DateTime                @default(now()) @map("data_solicitacao")
  dataAprovacao        DateTime?               @map("data_aprovacao")
  dataLiquidacao       DateTime?               @map("data_liquidacao")
  dataVencimento       DateTime                @map("data_vencimento")
  registradora         String                  @default("CERC") // CERC, CIP, B3, TAG, INTERNA
  protocoloRegistroUr  String?                 @map("protocolo_registro_ur")
  statusTravaBancaria  String                  @default("PENDENTE") @map("status_trava_bancaria") // PENDENTE, REGISTRADA, ATIVA, LIBERADA
  adquirentesTravadas  String?                 @map("adquirentes_travadas") // "CIELO, REDE, STONE, GETNET"
  aprovadoPor          String?                 @map("aprovado_por")
  motivoRejeicao       String?                 @map("motivo_rejeicao")
  documentoAssinaturaId String?                @map("documento_assinatura_id")
  observacoes          String?                 @db.Text
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  amortizacoes         AmortizacaoAntecipacao[]
  travas               TravaDomicilioBancario[]

  @@index([producerId])
  @@index([eventId])
  @@index([status])
  @@index([dataVencimento])
  @@map("antecipacoes_recebiveis")
}

model AmortizacaoAntecipacao {
  id                String               @id @default(uuid())
  antecipacaoId     String               @map("antecipacao_id")
  antecipacao       AntecipacaoRecebivel @relation(fields: [antecipacaoId], references: [id], onDelete: Cascade)
  repasseId         String?              @map("repasse_id")
  valorAmortizado   Decimal              @db.Decimal(15, 2) @map("valor_amortizado")
  saldoAnterior     Decimal              @db.Decimal(15, 2) @map("saldo_anterior")
  saldoRestante     Decimal              @db.Decimal(15, 2) @map("saldo_restante")
  dataAmortizacao   DateTime             @default(now()) @map("data_amortizacao")
  origemAmortizacao String               @default("REPASSE_AUTOMATICO") @map("origem_amortizacao") // REPASSE_AUTOMATICO, RETENCAO_BILHETERIA, TRAVA_CRUZADA_OUTRO_EVENTO, LIQUIDACAO_AVULSA
  observacao        String?              @db.Text
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([antecipacaoId])
  @@index([repasseId])
  @@index([dataAmortizacao])
  @@map("amortizacoes_antecipacoes")
}

model TravaDomicilioBancario {
  id                String               @id @default(uuid())
  antecipacaoId     String               @map("antecipacao_id")
  antecipacao       AntecipacaoRecebivel @relation(fields: [antecipacaoId], references: [id], onDelete: Cascade)
  producerId        String               @map("producer_id")
  adquirente        String               // CIELO, REDE, STONE, GETNET, PAGSEGURO
  contaBancariaId   String?              @map("conta_bancaria_id")
  banco             String
  agencia           String
  conta             String
  registradora      String               @default("CERC") // CERC, CIP, B3, TAG
  protocoloContrato String               @map("protocolo_contrato")
  status            String               @default("ATIVA") // ATIVA, SUSPENSA, LIBERADA
  dataEfetivacao    DateTime             @default(now()) @map("data_efetivacao")
  dataLiberacao     DateTime?            @map("data_liberacao")
  createdAt         DateTime             @default(now()) @map("created_at")

  @@index([antecipacaoId])
  @@index([producerId])
  @@index([adquirente])
  @@index([status])
  @@map("travas_domicilio_bancario")
}

// ------------------------------------------------------------------------------
// FASE 18: SPLIT DE PAGAMENTO NATIVO EM GATEWAYS & ADQUIRENTES
// Segregação Primária de Receita no Checkout (LC 116/03 & IN RFB 2.179 / COSIT 23/14)
// ------------------------------------------------------------------------------

model GatewaySubaccount {
  id                      String   @id @default(uuid())
  producerId              String   @map("producer_id")
  producerNome            String   @map("producer_nome")
  gateway                 String   // CIELO, PAGARME_STONE, EREDE, PAGBANK, ASAAS
  recipientId             String   @unique @map("recipient_id") // ID externo do recebedor na adquirente
  statusKyc               String   @default("PENDENTE") @map("status_kyc") // PENDENTE, EM_ANALISE, APROVADO, REJEITADO
  documentoFiscal         String   @map("documento_fiscal") // CNPJ ou CPF
  razaoSocial             String   @map("razao_social")
  banco                   String
  agencia                 String
  conta                   String
  tipoChavePix            String?  @map("tipo_chave_pix")
  chavePix                String?  @map("chave_pix")
  transferenciaAutomatica Boolean  @default(true) @map("transferencia_automatica")
  periodicidadeLiquidacao String   @default("D+30") @map("periodicidade_liquidacao") // D+1_PIX, D+30_CREDITO, SEMANAL
  motivoReprovacaoKyc     String?  @map("motivo_reprovacao_kyc")
  homologadoEm            DateTime? @map("homologado_em")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  splitConfigs            GatewaySplitConfig[]
  splitTransactions       PaymentSplitTransaction[]

  @@index([producerId])
  @@index([gateway])
  @@index([statusKyc])
  @@map("gateway_subaccounts")
}

model GatewaySplitConfig {
  id                           String             @id @default(uuid())
  eventId                      String             @unique @map("event_id")
  eventNome                    String             @map("event_nome")
  producerId                   String             @map("producer_id")
  subaccountId                 String             @map("subaccount_id")
  subaccount                   GatewaySubaccount  @relation(fields: [subaccountId], references: [id], onDelete: Cascade)
  gateway                      String             @default("PAGARME_STONE") // CIELO, PAGARME_STONE, EREDE, PAGBANK, ASAAS
  tipoDivisao                  String             @default("PERCENTUAL") @map("tipo_divisao") // PERCENTUAL, VALOR_FIXO_MAIS_PERCENTUAL
  comissaoDiskPercent          Decimal            @default(12.00) @db.Decimal(5, 2) @map("comissao_disk_percent")
  taxaServicoFixa              Decimal            @default(0.00) @db.Decimal(10, 2) @map("taxa_servico_fixa")
  produtorMdrAbsorvido         Boolean            @default(true) @map("produtor_mdr_absorvido") // true: Produtor arca com MDR; false: Disk arca com MDR
  produtorChargebackResponsavel Boolean           @default(true) @map("produtor_chargeback_responsavel")
  status                       String             @default("ATIVO") // ATIVO, INATIVO, RASCUNHO
  criadoPor                    String             @map("criado_por")
  createdAt                    DateTime           @default(now()) @map("created_at")
  updatedAt                    DateTime           @updatedAt @map("updated_at")

  @@index([producerId])
  @@index([gateway])
  @@index([status])
  @@map("gateway_split_configs")
}

model PaymentSplitTransaction {
  id                   String             @id @default(uuid())
  codigoTransacao      String             @unique @map("codigo_transacao") // Ex: "SPL-2026-000412"
  transacaoIdExterna   String             @map("transacao_id_externa")
  paymentId            String?            @map("payment_id")
  saleId               String?            @map("sale_id")
  eventId              String             @map("event_id")
  eventNome            String             @map("event_nome")
  subaccountId         String             @map("subaccount_id")
  subaccount           GatewaySubaccount  @relation(fields: [subaccountId], references: [id], onDelete: Restrict)
  gateway              String             // CIELO, PAGARME_STONE, EREDE, PAGBANK, ASAAS
  metodoPagamento      String             @map("metodo_pagamento") // PIX, CARTAO_CREDITO_1X, CARTAO_CREDITO_PARCELADO, CARTAO_DEBITO
  valorTotalBruto      Decimal            @db.Decimal(15, 2) @map("valor_total_bruto")
  valorProdutor        Decimal            @db.Decimal(15, 2) @map("valor_produtor")
  valorDiskIngressos   Decimal            @db.Decimal(15, 2) @map("valor_disk_ingressos")
  valorMdrTotal        Decimal            @default(0.00) @db.Decimal(10, 2) @map("valor_mdr_total")
  mdrProdutor          Decimal            @default(0.00) @db.Decimal(10, 2) @map("mdr_produtor")
  mdrDiskIngressos     Decimal            @default(0.00) @db.Decimal(10, 2) @map("mdr_disk_ingressos")
  status               String             @default("PROCESSADO") // PROCESSADO, RETIDO_ESCROW, LIQUIDADO, ESTORNADO, CONTESTADO_CHARGEBACK
  estornadoEm          DateTime?          @map("estornado_em")
  motivoEstorno        String?            @map("motivo_estorno")
  liquidadoEm          DateTime?          @map("liquidado_em")
  createdAt            DateTime           @default(now()) @map("created_at")

  @@index([eventId])
  @@index([subaccountId])
  @@index([gateway])
  @@index([status])
  @@index([createdAt])
  @@map("payment_split_transactions")
}

// ------------------------------------------------------------------------------
// FASE 19: SOCIEDADES EM CONTA DE PARTICIPAÇÃO (SCP) & INVESTIDORES
// Aportes de Capital, Hurdle Waterfall & Distribuição de Dividendos (CC 991-996 & Lei 9.249/95)
// ------------------------------------------------------------------------------

model ScpContract {
  id                   String                    @id @default(uuid())
  codigoScp            String                    @unique @map("codigo_scp") // Ex: "SCP-2026-001"
  nomeProjeto          String                    @map("nome_projeto") // Ex: "Festival de Inverno Curitiba 2026 - SCP"
  eventId              String                    @map("event_id")
  eventNome            String                    @map("event_nome")
  producerId           String                    @map("producer_id")
  socioOstensivo       String                    @map("socio_ostensivo") // Razão Social do Sócio Ostensivo (Produtora ou Disk)
  cnpjScp              String?                   @map("cnpj_scp") // CNPJ próprio da SCP na Receita Federal (IN RFB 2.119/22)
  metaCaptacao         Decimal                   @db.Decimal(15, 2) @map("meta_captacao") // Meta total de captação
  valorCaptado         Decimal                   @default(0.00) @db.Decimal(15, 2) @map("valor_captado")
  modalidadePartilha   String                    @default("HURDLE_WATERFALL") @map("modalidade_partilha") // LUCRO_LIQUIDO, HURDLE_WATERFALL, RECEITA_BRUTA
  hurdleRatePercent    Decimal                   @default(12.00) @db.Decimal(5, 2) @map("hurdle_rate_percent") // Taxa mínima de retorno preferencial (%)
  upsideSharePercent   Decimal                   @default(25.00) @db.Decimal(5, 2) @map("upside_share_percent") // Participação no lucro residual (%)
  regimeTributario     String                    @default("LUCRO_PRESUMIDO_ISENTO") @map("regime_tributario") // LUCRO_PRESUMIDO_ISENTO, MUTUO_IRRF_REGRESSIVO
  status               String                    @default("EM_CAPTACAO") // EM_CAPTACAO, ATIVO, EM_APURACAO, LIQUIDADO, ENCERRADO
  dataInicio           DateTime                  @default(now()) @map("data_inicio")
  dataEncerramento     DateTime?                 @map("data_encerramento")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  quotas               ScpQuotaShare[]
  distribuicoes        ScpDividendDistribution[]

  @@index([eventId])
  @@index([producerId])
  @@index([status])
  @@map("scp_contracts")
}

model ScpInvestor {
  id                   String                    @id @default(uuid())
  nomeOuRazaoSocial    String                    @map("nome_ou_razao_social")
  tipoPessoa           String                    @default("PJ") @map("tipo_pessoa") // PF, PJ
  documentoFiscal      String                    @unique @map("documento_fiscal") // CPF ou CNPJ
  email                String
  telefone             String?
  tipoInvestidor       String                    @default("ANJO") @map("tipo_investidor") // ANJO, CO_PRODUTOR, FUNDO_INVESTIMENTO, FAMILY_OFFICE
  banco                String
  agencia              String
  conta                String
  tipoChavePix         String?                   @map("tipo_chave_pix")
  chavePix             String?                   @map("chave_pix")
  statusKyc            String                    @default("APROVADO") @map("status_kyc") // PENDENTE, EM_ANALISE, APROVADO, REJEITADO
  limiteAporte         Decimal                   @default(500000.00) @db.Decimal(15, 2) @map("limite_aporte")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  quotas               ScpQuotaShare[]
  distribuicoes        ScpDividendDistribution[]

  @@index([statusKyc])
  @@index([tipoInvestidor])
  @@map("scp_investors")
}

model ScpQuotaShare {
  id                   String                    @id @default(uuid())
  codigoAporte         String                    @unique @map("codigo_aporte") // Ex: "APT-2026-0041"
  contractId           String                    @map("contract_id")
  contract             ScpContract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  investorId           String                    @map("investor_id")
  investor             ScpInvestor               @relation(fields: [investorId], references: [id], onDelete: Restrict)
  valorAportado        Decimal                   @db.Decimal(15, 2) @map("valor_aportado")
  percentualParticipacao Decimal                 @db.Decimal(5, 2) @map("percentual_participacao") // % do investidor na SCP
  dataAporte           DateTime                  @default(now()) @map("data_aporte")
  status               String                    @default("INTEGRALIZADO") // INTEGRALIZADO, PENDENTE_COMPROVANTE, RESCINDIDO
  comprovanteUrl       String?                   @map("comprovante_url")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([investorId])
  @@index([status])
  @@map("scp_quota_shares")
}

model ScpDividendDistribution {
  id                   String                    @id @default(uuid())
  codigoDistribuicao   String                    @unique @map("codigo_distribuicao") // Ex: "DIV-2026-0012"
  contractId           String                    @map("contract_id")
  contract             ScpContract               @relation(fields: [contractId], references: [id], onDelete: Restrict)
  investorId           String                    @map("investor_id")
  investor             ScpInvestor               @relation(fields: [investorId], references: [id], onDelete: Restrict)
  eventId              String                    @map("event_id")
  eventNome            String                    @map("event_nome")
  dreReceitaBruta      Decimal                   @db.Decimal(15, 2) @map("dre_receita_bruta")
  dreCustosOperacionais Decimal                  @db.Decimal(15, 2) @map("dre_custos_operacionais")
  dreLucroLiquido      Decimal                   @db.Decimal(15, 2) @map("dre_lucro_liquido")
  valorAporteDevolvido Decimal                   @default(0.00) @db.Decimal(15, 2) @map("valor_aporte_devolvido") // Retorno do capital (Payback)
  valorLucroDistribuido Decimal                  @default(0.00) @db.Decimal(15, 2) @map("valor_lucro_distribuido") // Dividendo / Lucro
  aliquotaIrrf         Decimal                   @default(0.00) @db.Decimal(5, 2) @map("aliquota_irrf") // 0.00% (Lei 9.249/95) ou 15.00%
  valorIrrfRetido      Decimal                   @default(0.00) @db.Decimal(15, 2) @map("valor_irrf_retido")
  valorLiquidoPago     Decimal                   @db.Decimal(15, 2) @map("valor_liquido_pago")
  roiEfetivoPercent    Decimal                   @default(0.00) @db.Decimal(5, 2) @map("roi_efetivo_percent") // ROI % sobre o capital
  status               String                    @default("CALCULADO") // CALCULADO, APROVADO_CFO, LIQUIDADO, PENDENTE_AUDITORIA
  dataAprovacao        DateTime?                 @map("data_aprovacao")
  dataLiquidacao       DateTime?                 @map("data_liquidacao")
  metodoLiquidacao     String?                   @map("metodo_liquidacao") // PIX, TED
  comprovantePagamento String?                   @map("comprovante_pagamento")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  @@index([contractId])
  @@index([investorId])
  @@index([eventId])
  @@index([status])
  @@map("scp_dividend_distributions")

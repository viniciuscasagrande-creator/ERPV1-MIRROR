  ativoTotal            Decimal  @db.Decimal(15, 2) @map("ativo_total")
  passivoCirculanteTotal Decimal @db.Decimal(15, 2) @map("passivo_circulante_total")
  passivoNaoCirculanteTotal Decimal @db.Decimal(15, 2) @map("passivo_nao_circulante_total")
  patrimonioLiquidoTotal Decimal @db.Decimal(15, 2) @map("patrimonio_liquido_total")
  ajusteAvaliacaoPatrimonial Decimal @default(0.00) @db.Decimal(15, 2) @map("ajuste_avaliacao_patrimonial") // AAP conversão FX
  receitaLiquidaConsolidada Decimal @db.Decimal(15, 2) @map("receita_liquida_consolidada")
  lucroLiquidoConsolidado Decimal @db.Decimal(15, 2) @map("lucro_liquido_consolidado")

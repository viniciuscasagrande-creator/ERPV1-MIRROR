model TaxReformConfig {
  id                        String   @id @default(uuid())
  vigenciaAno               Int      @default(2026) @map("vigencia_ano")
  cbsAliquotaPadraoPercent  Decimal  @default(8.80) @db.Decimal(5, 2) @map("cbs_aliquota_padrao_percent")
  ibsAliquotaPadraoPercent  Decimal  @default(17.70) @db.Decimal(5, 2) @map("ibs_aliquota_padrao_percent")
  reducaoEventosPercent     Decimal  @default(60.00) @db.Decimal(5, 2) @map("reducao_eventos_percent") // Redução de 60% para eventos culturais e shows
  cbsAliquotaEventosPercent Decimal  @default(3.52) @db.Decimal(5, 2) @map("cbs_aliquota_eventos_percent") // 8.80% * (1 - 0.60) = 3.52%
  ibsAliquotaEventosPercent Decimal  @default(7.08) @db.Decimal(5, 2) @map("ibs_aliquota_eventos_percent") // 17.70% * (1 - 0.60) = 7.08%
  aliquotaTeste2026Ativa    Boolean  @default(true) @map("aliquota_teste_2026_ativa") // 0.9% CBS + 0.1% IBS em 2026
  splitTributarioAtivo      Boolean  @default(true) @map("split_tributario_ativo") // Retenção automática no checkout
  ambienteHomologacao       Boolean  @default(true) @map("ambiente_homologacao")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@map("tax_reform_configs")
}


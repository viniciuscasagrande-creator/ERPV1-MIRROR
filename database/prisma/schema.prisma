  endToEndId            String?                   @unique @map("end_to_end_id") // Identificador único ponta-a-ponta gerado pelo SPI
  eventId               String                    @map("event_id")
  eventNome             String                    @map("event_nome")
  producerId            String                    @map("producer_id")
  valorTotal            Decimal                   @db.Decimal(15, 2) @map("valor_total")

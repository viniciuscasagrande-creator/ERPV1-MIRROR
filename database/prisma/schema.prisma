model OpenFinanceConsent {
  id                   String                    @id @default(uuid())
  consentId            String                    @unique @map("consent_id") // ID do consentimento FAPI (urn:banco:...)
  userId               String                    @map("user_id")
  producerId           String?                   @map("producer_id")
  instituicao          String                    // ITAU, BRADESCO, BANCO_DO_BRASIL, SANTANDER, NUBANK, INTER
  nomeTitular          String                    @map("nome_titular")
  documentoTitular     String                    @map("documento_titular")
  status               String                    @default("AWAITING_AUTHORISATION") // AWAITING_AUTHORISATION, AUTHORISED, REJECTED, REVOKED
  escopos              String                    @default("payments") // payments, accounts
  dataValidade         DateTime                  @map("data_validade")
  autorizadoEm         DateTime?                 @map("autorizado_em")
  revogadoEm           DateTime?                 @map("revogado_em")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  paymentOrders        OpenFinancePaymentOrder[]

  @@index([userId])
  @@index([producerId])
  @@index([status])
  @@map("open_finance_consents")
}

model PixCobrancaDynamic {

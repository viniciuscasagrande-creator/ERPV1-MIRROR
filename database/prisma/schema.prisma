model ConsolidatedBalanceSheet {
  id                    String   @id @default(uuid())
  codigoDemonstracao    String   @unique @map("codigo_demonstracao") // Ex: "DFS-IFRS-2026-01"
  periodo               String   @map("periodo") // Ex: "2026-03" ou "1T-2026"
  moedaApresentacao     String   @default("BRL") @map("moeda_apresentacao") // BRL, USD, EUR
  taxaConversaoFechamento Decimal @default(1.0000) @db.Decimal(10, 4) @map("taxa_conversao_fechamento")
  ativoCirculanteTotal  Decimal  @db.Decimal(15, 2) @map("ativo_circulante_total")

  moedaEstrangeira      String   @map("moeda_estrangeira") // USD, EUR, GBP
  valorMoedaEstrangeira Decimal  @db.Decimal(12, 2) @map("valor_moeda_estrangeira")
  taxaCambioAplicada    Decimal  @db.Decimal(10, 4) @map("taxa_cambio_aplicada")
  aliquotaIofPercent    Decimal  @default(4.38) @db.Decimal(5, 2) @map("aliquota_iof_percent") // Decreto 6.306/07
  valorIofBrl           Decimal  @db.Decimal(10, 2) @map("valor_iof_brl")
  valorTotalBrl         Decimal  @db.Decimal(12, 2) @map("valor_total_brl")
  valorLiquidoProdutorBrl Decimal @db.Decimal(12, 2) @map("valor_liquido_produtor_brl")
  spreadReceitaDiskBrl  Decimal  @db.Decimal(10, 2) @map("spread_receita_disk_brl")
  statusCambial         String   @default("LIQUIDADO_BORDERO") // COTADO, TRAVADO_SPOT, LIQUIDADO_BORDERO, CANCELADO
  dataTransacao         DateTime @default(now()) @map("data_transacao")

  @@index([eventoId])
  @@index([moedaEstrangeira])
  @@index([statusCambial])

  administradorFiduciario       String   @map("administrador_fiduciario")
  custodiante                   String   @map("custodiante")
  gestorCarteira                String   @map("gestor_carteira")
  patrimonioLiquidoTotalBrl     Decimal  @db.Decimal(15, 2) @map("patrimonio_liquido_total_brl")
  valorCotasSenioresBrl         Decimal  @db.Decimal(15, 2) @map("valor_cotas_seniores_brl")
  valorCotasMezaninoBrl         Decimal  @db.Decimal(15, 2) @map("valor_cotas_mezanino_brl")
  valorCotasSubordinadasBrl     Decimal  @db.Decimal(15, 2) @map("valor_cotas_subordinadas_brl")
  indiceSubordinacaoAtualPercent Decimal @db.Decimal(5, 2) @map("indice_subordinacao_atual_percent")
  indiceSubordinacaoMinimoPercent Decimal @default(25.00) @db.Decimal(5, 2) @map("indice_subordinacao_minimo_percent")
  metaRentabilidadeSenior       String   @map("meta_rentabilidade_senior") // Ex: "100% CDI + 2.80% a.a."
  statusFundo                   String   @default("ATIVO_OPERACIONAL") @map("status_fundo") // ATIVO_OPERACIONAL, EM_CAPTACAO, LIQUIDACAO_ENCERRADA

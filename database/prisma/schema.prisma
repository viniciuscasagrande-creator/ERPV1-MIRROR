  bancoDestino          String                    @map("banco_destino")
  chavePixDestino       String                    @map("chave_pix_destino")
  valor                 Decimal                   @db.Decimal(15, 2)
  status                String                    @default("INICIADO") // INICIADO, AGUARDANDO_AUTORIZACAO, PROCESSANDO, LIQUIDADO, REJEITADO
  endToEndId            String?                   @map("end_to_end_id")
  iniciadoPor           String                    @map("iniciado_por")
  liquidadoEm           DateTime?                 @map("liquidado_em")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  @@index([consentId])
  @@index([status])
  @@map("open_finance_payment_orders")
}

model RealtimeReconciliationLog {
  id                    String                    @id @default(uuid())
  codigoConciliacao     String                    @unique @map("codigo_conciliacao") // Ex: "REC-RT-2026-0091"
  cobrancaPixId         String?                   @map("cobranca_pix_id")
  cobrancaPix           PixCobrancaDynamic?       @relation(fields: [cobrancaPixId], references: [id], onDelete: SetNull)
  endToEndId            String                    @map("end_to_end_id")
  valorEsperado         Decimal                   @db.Decimal(15, 2) @map("valor_esperado")
  valorRecebido         Decimal                   @db.Decimal(15, 2) @map("valor_recebido")
  diferencaCentavos     Decimal                   @default(0.00) @db.Decimal(10, 2) @map("diferenca_centavos")
  metodoMatch           String                    @map("metodo_match") // EXATO_TXID, E2E_PREDITIVO_IA, MANUAL_AUDITADO
  tempoProcessamentoMs  Int                       @map("tempo_processamento_ms") // Latência da conciliação em ms (ex: 85ms)
  statusConciliacao     String                    @default("CONCILIADO_SUCESSO") // CONCILIADO_SUCESSO, DIVERGENCIA_PENDENTE, AJUSTE_TOLERANCIA
  webhookOrigemIp       String?                   @map("webhook_origem_ip")
  conciliadoEm          DateTime                  @default(now()) @map("conciliado_em")

  @@index([endToEndId])
  @@index([statusConciliacao])
  @@map("realtime_reconciliation_logs")
}


model GatewayIntegration {
  id                   String         @id @default(uuid())
  nome                 String
  codigo               String         @unique // CIELO, STONE, REDE, PAGBANK
  status               StatusGateway  @default(ATIVO)
  taxaMdrPadrao        Decimal        @default(2.89) @db.Decimal(5, 2) @map("taxa_mdr_padrao")
  webhookUrl           String?        @map("webhook_url")
  totalTransacoesHoje  Int            @default(0) @map("total_transacoes_hoje")
  volumeHoje           Decimal        @default(0.00) @db.Decimal(15, 2) @map("volume_hoje")
  taxaPraticadaMedia   Decimal        @default(2.89) @db.Decimal(5, 2) @map("taxa_praticada_media")
  desvioMdr            Decimal        @default(0.00) @db.Decimal(5, 2) @map("desvio_mdr")
  ultimaSincronizacao  DateTime?      @map("ultima_sincronizacao")

  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt      @map("updated_at")

  @@map("gateway_integrations")
}

// ------------------------------------------------------------------------------
// FASE 5: CONTABILIDADE OFICIAL (PLANO DE CONTAS, DIÁRIO, RAZÃO, BALANCETE & DRE)
// ------------------------------------------------------------------------------

model ChartOfAccounts {
  id          String        @id @default(uuid())
  codigo      String        @unique // Ex: '1.1.01.01.001'
  nome        String        // Ex: 'Banco Itaú - Conta Movimento'
  grupo       GrupoContabil
  natureza    NaturezaConta
  nivel       Int           // 1 (sintética) até 5 (analítica)
  analitica   Boolean       @default(true) // Recebe lançamentos diretos se true
  codigoPai   String?       @map("codigo_pai")
  saldoAtual  Decimal       @default(0.00) @db.Decimal(15, 2) @map("saldo_atual")
  ativo       Boolean       @default(true)

  journalItems JournalEntryItem[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt      @map("updated_at")

  @@index([codigo])
  @@index([grupo])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id                String             @id @default(uuid())
  numeroLancamento  String             @unique @map("numero_lancamento") // Ex: 'LAN-2026-000101'
  data              DateTime
  historico         String
  origem            String             @default("MANUAL") // BILHETERIA, REPASSE, PAGAMENTO, OFX, MANUAL
  origemId          String?            @map("origem_id")
  totalDebito       Decimal            @db.Decimal(15, 2) @map("total_debito")
  totalCredito      Decimal            @db.Decimal(15, 2) @map("total_credito")
  equilibrado       Boolean            @default(true)
  status            StatusLancamento   @default(CONFIRMADO)
  criadoPor         String?            @map("criado_por")

  items             JournalEntryItem[]

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt         @map("updated_at")

  @@index([data])
  @@index([status])
  @@map("journal_entries")
}

model JournalEntryItem {
  id                    String          @id @default(uuid())
  journalEntryId        String          @map("journal_entry_id")
  journalEntry          JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId             String          @map("account_id")
  account               ChartOfAccounts @relation(fields: [accountId], references: [id], onDelete: Restrict)
  tipo                  TipoPartida     // DEBITO ou CREDITO
  valor                 Decimal         @db.Decimal(15, 2)
  historicoComplementar String?         @map("historico_complementar")

  createdAt             DateTime        @default(now()) @map("created_at")

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_items")
}

// ------------------------------------------------------------------------------
// FASE 6: FISCAL, TRIBUTÁRIO, NOTAS FISCAIS (NFS-e/NF-e) & SPED
// ------------------------------------------------------------------------------

model FiscalInvoice {
  id                    String                @id @default(uuid())
  numeroNota            String                @unique @map("numero_nota") // Ex: 'NFS-2026-000142'
  serie                 String                @default("1")
  tipo                  TipoDocumentoFiscal   @default(NFSE)
  status                StatusDocumentoFiscal @default(AUTORIZADO)
  dataEmissao           DateTime              @default(now()) @map("data_emissao")
  competencia           String                // Ex: "2026-09"
  codigoVerificacao     String?               @map("codigo_verificacao")
  chaveAcesso           String?               @unique @map("chave_acesso")

  // Tomador do serviço
  tomadorTipo           String                @default("PRODUTOR") @map("tomador_tipo") // PRODUTOR ou CLIENTE
  tomadorNome           String                @map("tomador_nome")
  tomadorDoc            String                @map("tomador_doc") // CNPJ ou CPF
  tomadorEmail          String?               @map("tomador_email")
  tomadorCidade         String?               @default("Curitiba") @map("tomador_cidade")
  tomadorUf             String?               @default("PR") @map("tomador_uf")

  // Prestador (DiskIngressos)
  prestadorCnpj         String                @default("08.123.456/0001-99") @map("prestador_cnpj")
  prestadorIm           String                @default("123456-7") @map("prestador_im")

  // Tributação do Serviço
  codigoServico         String                @default("12.07") @map("codigo_servico") // 12.07 - Bilheteria e intermediação
  discriminacao         String                @db.Text
  
  // Valores
  valorServicos         Decimal               @db.Decimal(15, 2) @map("valor_servicos")
  valorDeducoes         Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_deducoes")
  baseCalculo           Decimal               @db.Decimal(15, 2) @map("base_calculo")
  aliquotaIss           Decimal               @default(5.00) @db.Decimal(5, 2) @map("aliquota_iss") // 5% em Curitiba
  valorIss              Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_iss")
  issRetido             Boolean               @default(false) @map("iss_retido")
  
  // Impostos Federais (PIS, COFINS, INSS, IR, CSLL)
  aliquotaPis           Decimal               @default(0.65) @db.Decimal(5, 2) @map("aliquota_pis")
  valorPis              Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_pis")
  aliquotaCofins        Decimal               @default(3.00) @db.Decimal(5, 2) @map("aliquota_cofins")
  valorCofins           Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_cofins")
  valorInss             Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_inss")
  valorIr               Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_ir")
  valorCsll             Decimal               @default(0.00) @db.Decimal(15, 2) @map("valor_csll")
  
  valorLiquido          Decimal               @db.Decimal(15, 2) @map("valor_liquido")

  // Vínculos Operacionais
  eventId               String?               @map("event_id")
  event                 Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Metadados
  xmlContent            String?               @db.Text @map("xml_content")
  motivoCancelamento    String?               @map("motivo_cancelamento")
  canceladoEm           DateTime?             @map("cancelado_em")

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt      @map("updated_at")

  @@index([numeroNota])
  @@index([competencia])
  @@index([status])
  @@index([eventId])
  @@map("fiscal_invoices")
}

model TaxRetention {
  id                    String          @id @default(uuid())
